#!/usr/bin/env python3
"""pintos-mkdisk: create Pintos virtual disks."""

from __future__ import annotations

import argparse
import os
import sys
from typing import Dict, List, Optional

import pintos_common as pc

USAGE = """\
pintos-mkdisk, a utility for creating Pintos virtual disks
Usage: pintos-mkdisk [OPTIONS] DISK [-- ARGUMENT...]
where DISK is the virtual disk to create,
      each ARGUMENT is inserted into the command line written to DISK,
  and each OPTION is one of the following options.
Partition options: (where PARTITION is one of: kernel filesys scratch swap)
  --PARTITION=FILE         Use a copy of FILE for the given PARTITION
  --PARTITION-size=SIZE    Create an empty PARTITION of the given SIZE in MB
  --PARTITION-from=DISK    Use of a copy of the given PARTITION in DISK
  (There is no --kernel-size option.)
Output disk options:
  --format=partitioned     Write partition table to output (default)
  --format=raw             Do not write partition table to output
  (Pintos can only use partitioned disks.)
Partitioned format output options:
  --loader[=FILE]          Get bootstrap loader from FILE (default: loader.bin
                           if --kernel option is specified, empty otherwise)
  --no-loader              Do not include a bootstrap loader
  --geometry=H,S           Use H head, S sector geometry (default: 16, 63)
  --geometry=zip           Use 64 head, 32 sector geometry for USB-ZIP boot
                           per http://syslinux.zytor.com/usbkey.php
  --align=bochs            Round size to cylinder for Bochs support (default)
  --align=full             Align partition boundaries to cylinder boundary to
                           let fdisk guess correct geometry and quiet warnings
  --align=none             Don't align partitions at all, to save space
Other options:
  -h, --help               Display this help message.
"""


def build_parser() -> pc.UsageParser:
    """Create the command-line parser."""
    parser = pc.UsageParser(prog='pintos-mkdisk', add_help=False)
    parser.add_argument('-h', '--help', action='store_true')

    # Partition sources are recorded in order so that a second source for
    # the same partition is reported where it occurs.
    for role in pc.ROLE_ORDER:
        parser.add_argument(f'--{role}', action=pc.OrderedAction,
                            const=(role, 'file'))
        parser.add_argument(f'--{role}-from', action=pc.OrderedAction,
                            const=(role, 'from'))
        if role != 'kernel':
            parser.add_argument(f'--{role}-size', action=pc.OrderedAction,
                                const=(role, 'size'))

    parser.add_argument('--format', dest='disk_format',
                        choices=('partitioned', 'raw'), default='partitioned')
    parser.add_argument('--loader', nargs='?', const='', default=None)
    parser.add_argument('--no-loader', action='store_true')
    parser.add_argument('--geometry')
    parser.add_argument('--align')
    parser.add_argument('disk', nargs='*')
    return parser


def main(argv: List[str]) -> int:
    """Run pintos-mkdisk; return the exit status."""
    options, kernel_args = pc.split_kernel_args(argv)
    parser = build_parser()
    namespace = parser.parse_args(options, argparse.Namespace(ordered=[]))
    if namespace.help:
        print(USAGE, end='')
        return 0
    if len(namespace.disk) != 1:
        print(USAGE, end='', file=sys.stderr)
        return 1
    disk_name = namespace.disk[0]
    kernel_args = kernel_args or []

    parts: Dict[str, pc.Partition] = {}
    for (role, source), arg in namespace.ordered:
        pc.register_partition(parts, role, source, arg)
    geometry = (pc.parse_geometry(namespace.geometry)
                if namespace.geometry is not None else pc.Geometry())
    align = (pc.check_alignment(namespace.align)
             if namespace.align is not None else 'bochs')
    if os.path.exists(disk_name):
        raise pc.PintosError(f'{disk_name}: already exists')

    # Figure out whether to include a loader.
    include_loader = namespace.loader is not None
    if include_loader and namespace.no_loader:
        raise pc.PintosError("can't specify both --loader and --no-loader")
    if not include_loader and not namespace.no_loader:
        include_loader = ('kernel' in parts
                          and namespace.disk_format == 'partitioned')
    if include_loader and namespace.disk_format == 'raw':
        raise pc.PintosError("can't write loader to raw disk")
    if kernel_args and not include_loader:
        raise pc.PintosError("can't write command-line arguments "
                             'without --loader or --kernel')
    if include_loader and 'kernel' not in parts:
        pc.warn('--loader only makes sense without --kernel if this disk '
                'will be used to load a kernel from another disk')

    loader: Optional[bytes] = None
    if include_loader:
        loader = pc.read_loader(namespace.loader or None)

    with open(disk_name, 'wb', buffering=0) as disk:
        pc.assemble_disk(disk, disk_name, parts, align=align,
                         geometry=geometry,
                         disk_format=namespace.disk_format, loader=loader,
                         args=kernel_args)
    return 0


if __name__ == '__main__':
    pc.run_tool(main)
