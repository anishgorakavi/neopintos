#!/usr/bin/env python3
"""pintos-set-cmdline: change the kernel command line stored in a disk."""

from __future__ import annotations

import struct
import sys
from typing import List

import pintos_common as pc

USAGE = """\
pintos-set-cmdline, a utility for changing the command line in Pintos disks
Usage: pintos-set-cmdline DISK -- [ARGUMENT...]
where DISK is a bootable disk containing a Pintos loader
  and each ARGUMENT is inserted into the command line written to DISK.
"""


def main(argv: List[str]) -> int:
    """Run pintos-set-cmdline; return the exit status."""
    if argv == ['--help']:
        print(USAGE, end='')
        return 0
    if len(argv) < 2 or argv[1] != '--':
        print(USAGE, end='', file=sys.stderr)
        return 1
    disk, kernel_args = argv[0], argv[2:]

    with open(disk, 'r+b', buffering=0) as handle:
        # Check that it's a partitioned disk with a Pintos loader.
        mbr = pc.read_fully(handle, disk, pc.SECTOR_SIZE)
        if struct.unpack_from('<H', mbr, 510)[0] != pc.MBR_SIGNATURE:
            raise pc.PintosError(f'{disk}: not a partitioned disk')
        if b'Pintos' not in mbr:
            raise pc.PintosError(f'{disk}: does not contain Pintos loader')

        # Write the command line.
        handle.seek(pc.LOADER_SIZE)
        pc.write_fully(handle, disk,
                       pc.make_kernel_command_line(kernel_args))
    return 0


if __name__ == '__main__':
    pc.run_tool(main)
