#!/usr/bin/env python3
"""backtrace: convert raw addresses into symbolic backtraces."""

from __future__ import annotations

import os
import re
import shutil
import subprocess
from typing import Dict, List, Optional

import pintos_common as pc

USAGE = """\
backtrace, for converting raw addresses into symbolic backtraces
usage: backtrace [BINARY]... ADDRESS...
where BINARY is the binary file or files from which to obtain symbols
 and ADDRESS is a raw address to convert to a symbol name.

If no BINARY is unspecified, the default is the first of kernel.o or
build/kernel.o that exists.  If multiple binaries are specified, each
symbol printed is from the first binary that contains a match.

The ADDRESS list should be taken from the "Call stack:" printed by the
kernel.  Read "Backtraces" in the "Debugging Tools" chapter of the
Pintos documentation for more information.
"""

# Words the kernel prints around the addresses in a "Call stack:" line.
GARBAGE = re.compile(r'(call|stack:?|[-+])', re.IGNORECASE)

# Candidate addr2line programs, in order of preference.  The i686 name is
# what the macOS cross toolchain installs.
ADDR2LINE_NAMES = ('i386-elf-addr2line', 'i686-elf-addr2line', 'addr2line')


def find_binaries(args: List[str]) -> List[str]:
    """Remove the leading binary names from ``args`` and return them.

    If there are none, the default kernel binary is returned.
    """
    binaries: List[str] = []
    while args and not args[0].startswith('0x'):
        binary = args.pop(0)
        if not os.path.exists(binary):
            raise pc.PintosError(
                f'backtrace: {binary}: not found (use --help for help)')
        binaries.append(binary)
    if not binaries:
        for default in ('kernel.o', os.path.join('build', 'kernel.o')):
            if os.path.exists(default):
                return [default]
        raise pc.PintosError(
            'backtrace: no binary specified and neither "kernel.o" nor '
            '"build/kernel.o" exists (use --help for help)')
    return binaries


def find_addr2line() -> str:
    """Return the path of an ``addr2line`` program, or fail."""
    for name in ADDR2LINE_NAMES:
        path = shutil.which(name)
        if path:
            return path
    raise pc.PintosError(
        "backtrace: neither `i386-elf-addr2line' nor `addr2line' in PATH")


def lookup(addr2line: str, binary: str, addresses: List[str]
           ) -> List[Optional[Dict[str, str]]]:
    """Ask ``addr2line`` about ``addresses`` in ``binary``.

    Returns, for each address, its function and source line, or ``None``
    if the binary does not know the address.
    """
    result = subprocess.run([addr2line, '-fe', binary, *addresses],
                            stdout=subprocess.PIPE, universal_newlines=True,
                            check=False)
    lines = result.stdout.splitlines()
    found: List[Optional[Dict[str, str]]] = []
    for index in range(len(addresses)):
        function = lines[2 * index] if 2 * index < len(lines) else '??'
        where = lines[2 * index + 1] if 2 * index + 1 < len(lines) else '??:0'
        if function != '??' or where != '??:0':
            found.append({'function': function, 'line': where})
        else:
            found.append(None)
    return found


def format_location(function: str, line: str) -> str:
    """Return ``function (file:line)`` with the file name shortened."""
    line = re.sub(r'^(\.\./)*', '', line)
    if len(line) > 28:
        line = '...' + line[-25:]
    return f'{function} ({line})'


def main(argv: List[str]) -> int:
    """Run backtrace; return the exit status."""
    if '-h' in argv or '--help' in argv:
        print(USAGE, end='')
        return 0
    if not argv:
        raise pc.PintosError(
            'backtrace: at least one argument required (use --help for help)')

    # Drop garbage inserted by the kernel.
    args = [arg for arg in argv if not GARBAGE.fullmatch(arg)]
    args = [arg[:-1] if arg.endswith('.') else arg for arg in args]

    binaries = find_binaries(args)
    addr2line = find_addr2line()

    # The first binary that recognises an address supplies its symbol.
    symbols: List[Optional[Dict[str, str]]] = [None] * len(args)
    owners: List[Optional[str]] = [None] * len(args)
    for binary in binaries:
        for index, symbol in enumerate(lookup(addr2line, binary, args)):
            if owners[index] is None and symbol is not None:
                symbols[index] = symbol
                owners[index] = binary

    current: Optional[str] = None
    for address, symbol, owner in zip(args, symbols, owners):
        if owner is not None and len(binaries) > 1 and owner != current:
            current = owner
            print(f'In {current}:')
        if re.fullmatch(r'0x[0-9a-f]+', address, re.IGNORECASE):
            address = f'0x{int(address, 16):08x}'
        if symbol is not None:
            description = format_location(symbol['function'], symbol['line'])
        else:
            description = '(unknown)'
        print(f'{address}: {description}')
    return 0


if __name__ == '__main__':
    pc.run_tool(main)
