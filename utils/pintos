# QEMU's isa-debug-exit device only allows odd exit statuses, so the kernel
# cannot exit with 0.  Exit status 0x63 is the alternate "clean" status.
QEMU_CLEAN_EXIT = 0x63

# Seconds to let a failed run go on, to collect more output, before killing.
FAILURE_GRACE_SECONDS = 5

# Largest number of IDE disks (two controllers, two disks each).
MAX_DISKS = 4

# Fixed ustar header fields: files are always root-owned, mode 0644, and
# dated 2006-01-01.
USTAR_MODE = 0o644
USTAR_MTIME = 1136102400
USTAR_NAME_MAX = 99


@dataclass
class FileSpec:
    """A file for ``-p`` or ``-g``, with its optional ``-a`` name."""

    name: str
    alias: Optional[str] = None

    @property
    def other_name(self) -> str:
        """The ``-a`` name if given, otherwise the same name."""
        return self.name if self.alias is None else self.alias


@dataclass
class Options:
    """Everything the command line configures."""

    start_time: float = field(default_factory=time.time)
    sim: Optional[str] = None            # bochs, qemu or player
    debug: str = 'none'                  # none, monitor or gdb
    mem: int = 4                         # Physical RAM in MB.
    serial: bool = True                  # Use the serial port?
    vga: Optional[str] = None            # window, terminal or none
    jitter: Optional[int] = None         # Seed for random timer interrupts.
    realtime: bool = False               # Timer interrupts follow real time?
    timeout: Optional[int] = None        # Maximum wall-clock seconds.
    kill_on_failure: bool = False
    puts: List[FileSpec] = field(default_factory=list)
    gets: List[FileSpec] = field(default_factory=list)
    last_file: Optional[FileSpec] = None  # Target of the next ``-a``.
    kernel_args: List[str] = field(default_factory=list)
    parts: Dict[str, pc.Partition] = field(default_factory=dict)
    make_disk: Optional[str] = None      # Disk to create; kept after the run.
    disks: List[str] = field(default_factory=list)
    loader_fn: Optional[str] = None
    geometry: pc.Geometry = pc.Geometry()
    align: Optional[str] = None
    gdb_port: str = field(
        default_factory=lambda: os.environ.get('GDB_PORT') or '1234')


class DiskInfo(NamedTuple):
    """A disk image's size and the IDE geometry used to describe it."""

    capacity: int      # Sectors.
    cylinders: int
    heads: int
    sectors: int


def usage(exit_code: int) -> NoReturn:
    """Print the usage message and exit with ``exit_code``."""
    print(USAGE, end='')
    sys.exit(exit_code)


# --------------------------------------------------------------------------
# Command line.

def build_parser() -> pc.UsageParser:
    """Create the parser for the options before ``--``."""
    parser = pc.UsageParser(prog='pintos', add_help=False)
    add = parser.add_argument

    def flag(*names: str, entry: Tuple[str, object]) -> None:
        add(*names, action=pc.OrderedAction, nargs=0, const=entry)

    def valued(*names: str, kind: object, **kwargs) -> None:
        add(*names, action=pc.OrderedAction, const=kind, **kwargs)

    valued('--sim', kind='sim')
    flag('--bochs', entry=('sim', 'bochs'))
    flag('--qemu', entry=('sim', 'qemu'))
    flag('--player', entry=('sim', 'player'))

    valued('--debug', kind='debug')
    flag('--no-debug', entry=('debug', 'none'))
    flag('--monitor', entry=('debug', 'monitor'))
    flag('--gdb', entry=('debug', 'gdb'))

    add('-m', '--memory', type=int, default=4)
    valued('-j', '--jitter', kind='jitter', type=int)
    flag('-r', '--realtime', entry=('realtime', None))

    add('-T', '--timeout', type=int)
    add('-k', '--kill-on-failure', action='store_true')

    flag('-v', '--no-vga', entry=('vga', 'none'))
    add('-s', '--no-serial', dest='serial', action='store_false')
    flag('-t', '--terminal', entry=('vga', 'terminal'))

    valued('-p', '--put-file', kind='put')
    valued('-g', '--get-file', kind='get')
    valued('-a', '--as', kind='as')

    add('-h', '--help', action='store_true')

    for role, source in (('kernel', 'file'), ('filesys', 'file'),
                         ('swap', 'file'), ('filesys', 'size'),
                         ('scratch', 'size'), ('swap', 'size'),
                         ('kernel', 'from'), ('filesys', 'from'),
                         ('swap', 'from')):
        suffix = '' if source == 'file' else '-' + source
        valued(f'--{role}{suffix}', kind=(role, source))

    add('--make-disk')
    valued('--disk', kind='disk')
    add('--loader')
    add('--geometry')
    add('--align')
    return parser


def parse_command_line(argv: Sequence[str]) -> Options:
    """Parse ``argv`` (without the program name) into ``Options``."""
    if not argv or list(argv) == ['--help']:
        usage(0)

    opts = Options()
    option_args, kernel_args = pc.split_kernel_args(argv)
    if kernel_args is None:
        # Without "--", everything is for the kernel.
        opts.kernel_args = list(argv)
    else:
        opts.kernel_args = kernel_args
        namespace = build_parser().parse_args(
            option_args, argparse.Namespace(ordered=[]))
        if namespace.help:
            usage(0)
        opts.mem = namespace.memory
        opts.timeout = namespace.timeout
        opts.kill_on_failure = namespace.kill_on_failure
        opts.serial = namespace.serial
        opts.make_disk = namespace.make_disk
        opts.loader_fn = namespace.loader
        if namespace.geometry is not None:
            opts.geometry = pc.parse_geometry(namespace.geometry)
        if namespace.align is not None:
            opts.align = pc.check_alignment(namespace.align)
        for kind, value in namespace.ordered:
            apply_option(opts, kind, value)

    if opts.sim is None:
        opts.sim = 'bochs' if shutil.which('bochs') else 'qemu'
    if opts.vga is None:
        opts.vga = ('window'
                    if 'DISPLAY' in os.environ or sys.platform == 'darwin'
                    else 'none')

    if opts.timeout is not None and opts.debug != 'none':
        opts.timeout = None
        print(f'warning: disabling timeout with --{opts.debug}')
    if opts.kill_on_failure and not opts.serial:
        print('warning: enabling serial port for -k or --kill-on-failure')
    if opts.sim == 'bochs' and opts.align == 'none':
        opts.align = 'bochs'
        pc.warn('setting --align=bochs for Bochs support')

    # Kill-on-failure has always been switched off here, whatever -k says
    # (the test harness relies on QEMU powering itself off).  The output
    # filter in Supervisor is kept so this can be turned back on.
    opts.kill_on_failure = False
    return opts


def apply_option(opts: Options, kind: object, value: object) -> None:
    """Apply one order-dependent option to ``opts``."""
    if isinstance(kind, tuple):
        role, source = kind
        pc.register_partition(opts.parts, role, source, str(value))
    elif kind == 'sim':
        set_sim(opts, str(value))
    elif kind == 'debug':
        set_debug(opts, str(value))
    elif kind == 'vga':
        set_vga(opts, str(value))
    elif kind == 'jitter':
        set_jitter(opts, int(str(value)))
    elif kind == 'realtime':
        set_realtime(opts)
    elif kind in ('put', 'get'):
        spec = opts.last_file = FileSpec(str(value))
        (opts.puts if kind == 'put' else opts.gets).append(spec)
    elif kind == 'as':
        set_as(opts, str(value))
    elif kind == 'disk':
        set_disk(opts, str(value))
    else:
        raise ValueError(f'unknown option kind {kind!r}')


def set_sim(opts: Options, new_sim: str) -> None:
    """Choose the simulator."""
    if opts.sim is not None and opts.sim != new_sim:
        raise pc.PintosError(f'--{new_sim} conflicts with --{opts.sim}')
    opts.sim = new_sim


def set_debug(opts: Options, new_debug: str) -> None:
    """Choose the debugger."""
    if (opts.debug != 'none' and new_debug != 'none'
            and opts.debug != new_debug):
        raise pc.PintosError(f'--{new_debug} conflicts with --{opts.debug}')
    opts.debug = new_debug


def set_vga(opts: Options, new_vga: str) -> None:
    """Choose where VGA output goes."""
    if opts.vga is not None and opts.vga != new_vga:
        print('warning: conflicting vga display options')
    opts.vga = new_vga


def set_jitter(opts: Options, new_jitter: int) -> None:
    """Randomize timer interrupts with seed ``new_jitter``."""
    if opts.realtime:
        raise pc.PintosError('--realtime conflicts with --jitter')
    if opts.jitter is not None and opts.jitter != new_jitter:
        raise pc.PintosError('different --jitter already defined')
    opts.jitter = new_jitter


def set_realtime(opts: Options) -> None:
    """Make timer interrupts follow real time."""
    if opts.jitter is not None:
        raise pc.PintosError('--realtime conflicts with --jitter')
    opts.realtime = True


def set_as(opts: Options, name: str) -> None:
    """Set the guest/host name of the previous ``-p`` or ``-g``."""
    if opts.last_file is None:
        raise pc.PintosError('-a (or --as) is only allowed after -p or -g')
    if opts.last_file.alias is not None:
        raise pc.PintosError(
            'Only one -a (or --as) is allowed after -p or -g')
    opts.last_file.alias = name


def set_disk(opts: Options, disk: str) -> None:
    """Include the existing disk ``disk``, and the partitions it holds."""
    opts.disks.append(disk)
    for role, part in pc.read_partition_table(disk).items():
        if role in opts.parts:
            raise pc.PintosError(
                f"can't have two sources for {role} partition")
        opts.parts[role] = part


# --------------------------------------------------------------------------
# Temporary files.

_temp_paths: List[str] = []


def make_temp_file(suffix: str) -> Tuple[BinaryIO, str]:
    """Create a temporary file that is deleted when the program exits."""
    descriptor, path = tempfile.mkstemp(suffix=suffix)
    _temp_paths.append(path)
    return os.fdopen(descriptor, 'wb', buffering=0), path


def remove_temp_files() -> None:
    """Delete all the temporary files."""
    while _temp_paths:
        try:
            os.unlink(_temp_paths.pop())
        except OSError:
            pass


atexit.register(remove_temp_files)


# --------------------------------------------------------------------------
# Disks.

def find_disks(opts: Options) -> None:
    """Locate the files behind each virtual disk and create the boot disk."""
    # Find the kernel, if we don't already have one.
    if 'kernel' not in opts.parts:
        name = pc.find_file('kernel.bin')
        if name is None:
            raise pc.PintosError('Cannot find kernel')
        pc.set_partition(opts.parts, 'kernel', 'file', name)

    # Try to find file system and swap disks, if we don't already have
    # those partitions.
    for role, base in (('filesys', 'filesys.dsk'), ('swap', 'swap.dsk')):
        if role not in opts.parts:
            name = pc.find_file(base)
            if name is not None:
                set_disk(opts, name)

    # Warn about (potentially) missing partitions.
    match = re.search(r'\b(threads|userprog|vm|filesys)\b', os.getcwd())
    if match:
        project = match.group(1)
        if project != 'threads' and 'filesys' not in opts.parts:
            pc.warn(f"it looks like you're running the {project} project, "
                    'but no file system partition is present')
        if project == 'vm' and 'swap' not in opts.parts:
            pc.warn(f"it looks like you're running the {project} project, "
                    'but no swap partition is present')

    # Open the disk to create.
    if opts.make_disk is None:
        disk, opts.make_disk = make_temp_file('.dsk')
    else:
        if os.path.exists(opts.make_disk):
            raise pc.PintosError(f'{opts.make_disk}: already exists')
        disk = open(opts.make_disk, 'wb', buffering=0)

    # Prepare the arguments to pass to the Pintos kernel: leading options
    # first, then the commands for the scratch disk, then the rest.
    kernel_args = list(opts.kernel_args)
    args: List[str] = []
    while kernel_args and kernel_args[0].startswith('-'):
        args.append(kernel_args.pop(0))
    if opts.puts:
        args.append('extract')
    args.extend(kernel_args)
    for get in opts.gets:
        args.extend(('append', get.name))

    # Make the disk from the partitions that aren't already on a disk.
    new_parts = {role: part for role, part in opts.parts.items()
                 if part.disk is None}
    pc.assemble_disk(disk, opts.make_disk, new_parts,
                     align=opts.align or 'bochs', geometry=opts.geometry,
                     loader=pc.read_loader(opts.loader_fn), args=args)

    # Put the new disk at the front of the list of disks.
    opts.disks.insert(0, opts.make_disk)
    if len(opts.disks) > MAX_DISKS:
        raise pc.PintosError(f"can't use more than {MAX_DISKS} disks")


def disk_geometry(path: str) -> DiskInfo:
    """Return a valid IDE disk geometry for the disk image ``path``."""
    size = os.path.getsize(path)
    if size % pc.SECTOR_SIZE:
        raise pc.PintosError(
            f'{path}: size {size} not a multiple of {pc.SECTOR_SIZE} bytes')
    heads, sectors = 16, 63
    cylinder_size = pc.SECTOR_SIZE * heads * sectors
    return DiskInfo(size // pc.SECTOR_SIZE, pc.div_round_up(size,
                                                            cylinder_size),
                    heads, sectors)


def extend_file(handle: BinaryIO, name: str, size: int) -> None:
    """Make the file ``handle`` at least ``size`` bytes long."""
    if os.fstat(handle.fileno()).st_size < size:
        handle.seek(size - 1)
        pc.write_fully(handle, name, b'\0')


# --------------------------------------------------------------------------
# The scratch disk, used by -p and -g.

def ustar_field(number: int, size: int) -> bytes:
    """Return ``number`` as a ``size``-byte octal field of a ustar header."""
    out = f'{number:0{size - 1}o}\0'
    if len(out) != size:
        raise pc.PintosError(
            f'{number}: too large for {size}-byte octal ustar field')
    return out.encode('ascii')


def ustar_checksum(header: bytes) -> int:
    """Return the checksum of a 512-byte ustar header.

    The checksum field itself counts as eight spaces.
    """
    if len(header) != pc.SECTOR_SIZE:
        raise ValueError('ustar header must be 512 bytes')
    return sum(header[:148]) + 8 * ord(' ') + sum(header[156:])


def make_ustar_header(name: bytes, size: int) -> bytes:
    """Return the ustar header of a regular file ``name`` of ``size`` bytes."""
    header = b''.join((
        name.ljust(100, b'\0'),                 # name
        ustar_field(USTAR_MODE, 8),             # mode
        ustar_field(0, 8),                      # uid
        ustar_field(0, 8),                      # gid
        ustar_field(size, 12),                  # size
        ustar_field(USTAR_MTIME, 12),           # mtime
        b' ' * 8,                               # chksum (filled in below)
        b'0',                                   # typeflag
        bytes(100),                             # linkname
        b'ustar\0',                             # magic
        b'00',                                  # version
        b'root'.ljust(32, b'\0'),               # uname
        b'root'.ljust(32, b'\0'),               # gname
        bytes(8),                               # devmajor
        bytes(8),                               # devminor
        bytes(155),                             # prefix
        bytes(12),                              # pad to 512 bytes
    ))
    checksum = ustar_checksum(header)
    return header[:148] + ustar_field(checksum, 8) + header[156:]


def parse_octal(field_bytes: bytes) -> int:
    """Parse a NUL-terminated octal ustar field; garbage counts as 0."""
    text = field_bytes.split(b'\0', 1)[0].decode('ascii', 'replace').strip()
    match = re.match(r'[0-7]*', text)
    return int(match.group(), 8) if match and match.group() else 0


def put_scratch_file(source_name: str, dest_name: str, disk: BinaryIO,
                     disk_name: str) -> None:
    """Write ``source_name`` to ``disk`` as ustar member ``dest_name``."""
    print(f'Copying {source_name} to scratch partition...')

    # The ustar format supports up to 100 characters for a file name, and
    # even longer names given some common properties, but our code in the
    # Pintos kernel only supports at most 99 characters.
    encoded = os.fsencode(dest_name)
    if len(encoded) > USTAR_NAME_MAX:
        raise pc.PintosError(
            f'{dest_name}: name too long (max {USTAR_NAME_MAX} characters)')

    size = os.stat(source_name).st_size
    pc.write_fully(disk, disk_name, make_ustar_header(encoded, size))

    with open(source_name, 'rb', buffering=0) as source:
        pc.copy_file(source, source_name, disk, disk_name, size)
        if os.fstat(source.fileno()).st_size != size:
            raise pc.PintosError(
                f'{source_name}: changed size while being read')

    # Round up disk data to the beginning of the next sector.
    if size % pc.SECTOR_SIZE:
        pc.write_zeros(disk, disk_name, pc.SECTOR_SIZE - size % pc.SECTOR_SIZE)


def get_scratch_file(dest_name: str, disk: BinaryIO,
                     disk_name: str) -> Optional[str]:
    """Copy the next ustar member of ``disk`` to the new file ``dest_name``.

    Returns ``None`` on success, otherwise a description of the problem.
    """
    print(f'Copying {dest_name} out of {disk_name}...')

    header = pc.read_fully(disk, disk_name, pc.SECTOR_SIZE)
    if header == bytes(pc.SECTOR_SIZE):
        return 'scratch disk tar archive ends unexpectedly'
    if header[257:263] != b'ustar\0':
        return 'corrupt ustar signature'
    if header[263:265] != b'00':
        return 'invalid ustar version'
    if parse_octal(header[148:156]) != ustar_checksum(header):
        return 'checksum mismatch'
    if header[156:157] not in (b'0', b'\0'):
        return 'not a regular file'

    size = parse_octal(header[124:136])
    descriptor = os.open(dest_name, os.O_WRONLY | os.O_CREAT, 0o666)
    with os.fdopen(descriptor, 'wb', buffering=0) as dest:
        pc.copy_file(disk, disk_name, dest, dest_name, size)

    # Skip forward in the disk up to the beginning of the next sector.
    if size % pc.SECTOR_SIZE:
        pc.read_fully(disk, disk_name, pc.SECTOR_SIZE - size % pc.SECTOR_SIZE)
    return None


def prepare_scratch_disk(opts: Options) -> None:
    """Build the scratch partition holding the files for ``-p``."""
    if not opts.gets and not opts.puts:
        return

    scratch = opts.parts.setdefault('scratch', pc.Partition())

    # Create a temporary partition and write the files to put to it, then
    # write an end-of-archive marker.
    handle, part_name = make_temp_file('.part')
    with handle:
        for put in opts.puts:
            put_scratch_file(put.name, put.other_name, handle, part_name)
        pc.write_fully(handle, part_name, bytes(1024))

        # Make sure the scratch disk is big enough to get big files and at
        # least as big as any requested size.
        size = pc.round_up(max(len(opts.gets) * 1024 * 1024, scratch.nbytes),
                           pc.SECTOR_SIZE)
        extend_file(handle, part_name, size)

    if scratch.disk is not None:
        # Copy the scratch partition into the existing disk.
        if scratch.sectors * pc.SECTOR_SIZE < size:
            raise pc.PintosError(
                f'{scratch.disk}: scratch partition too small')
        with open(part_name, 'rb', buffering=0) as source, \
                open(scratch.disk, 'r+b', buffering=0) as disk:
            disk.seek(scratch.start * pc.SECTOR_SIZE)
            pc.copy_file(source, part_name, disk, scratch.disk, size)
    else:
        # Use the temporary file as the source of the scratch partition.
        pc.set_partition(opts.parts, 'scratch', 'file', part_name)


def finish_scratch_disk(opts: Options) -> None:
    """Read the files for ``-g`` back from the scratch disk."""
    if not opts.gets:
        return

    scratch = opts.parts['scratch']
    assert scratch.disk is not None
    disk_name = scratch.disk
    part_end = (scratch.start + scratch.sectors) * pc.SECTOR_SIZE

    # If reading fails, delete that file and all subsequent files, but
    # don't die with an error, because that's a guest error, not a host
    # error.  (An error exit would foul up the grading process.)
    with open(disk_name, 'rb', buffering=0) as disk:
        disk.seek(scratch.start * pc.SECTOR_SIZE)
        ok = True
        for get in opts.gets:
            name = get.other_name
            if ok:
                error = get_scratch_file(name, disk, disk_name)
                if error is None and disk.tell() > part_end:
                    error = f'{disk_name}: scratch data overflows partition'
                if error:
                    print(f'getting {name} failed ({error})', file=sys.stderr)
                    ok = False
            if not ok:
                try:
                    os.unlink(name)
                except FileNotFoundError:
                    pass


# --------------------------------------------------------------------------
# Running subprocesses.

class _TimeLimit(Exception):
    """Raised by the SIGALRM handler when the time limit is reached."""


class _Interrupted(Exception):
    """Raised by the SIGINT and SIGTERM handler."""

    def __init__(self, number: int) -> None:
        """Remember which signal ``number`` arrived."""
        super().__init__(number)
        self.number = number


def _raise_time_limit(_number: int, _frame: object) -> None:
    raise _TimeLimit


def _raise_interrupted(number: int, _frame: object) -> None:
    raise _Interrupted(number)


class Supervisor:
    """Runs a simulator, enforcing the timeout and relaying signals.

    The signal handlers only raise exceptions, so the real work happens in
    ``run`` and never inside a handler (a handler that waits for the
    process would deadlock on ``Popen``'s own lock).

    QEMU turns off local echo on the terminal and does not restore it if it
    is killed by a signal, so the terminal settings are restored here.
    """

    def __init__(self, opts: Options, proc: 'subprocess.Popen[bytes]',
                 terminal: Optional[list]) -> None:
        """Supervise ``proc``; ``terminal`` is the termios state to restore."""
        self.opts = opts
        self.proc = proc
        self.terminal = terminal
        self.cause: Optional[str] = None   # Why a failed run is being killed.

    def run(self) -> int:
        """Wait for the process; return its exit status.

        A negative status means the process died from that signal.  If the
        time limit is reached the process is killed and this program exits.
        """
        handlers = {signal.SIGALRM: _raise_time_limit,
                    signal.SIGINT: _raise_interrupted,
                    signal.SIGTERM: _raise_interrupted}
        saved = {number: signal.signal(number, handler)
                 for number, handler in handlers.items()}
        try:
            try:
                if self.opts.timeout is not None:
                    signal.alarm(self.opts.timeout)
                if self.opts.kill_on_failure:
                    self._filter_output()
                self.proc.wait()
            finally:
                signal.alarm(0)
        except _TimeLimit:
            self._time_limit_reached()
        except _Interrupted as interrupt:
            self._relay(interrupt.number)
        finally:
            for number, handler in saved.items():
                signal.signal(number, handler)
            self._restore_terminal()
        return self.proc.returncode

    def _restore_terminal(self) -> None:
        if self.terminal is not None:
            termios.tcsetattr(0, termios.TCSANOW, self.terminal)

    def _relay(self, number: int) -> NoReturn:
        """Relay a signal to the process, then die from it ourselves."""
        self.proc.send_signal(number)
        remove_temp_files()
        self._restore_terminal()
        signal.signal(number, signal.SIG_DFL)
        os.kill(os.getpid(), number)
        sys.exit(128 + number)      # Not reached: the signal kills us.

    def _time_limit_reached(self) -> NoReturn:
        """Kill the process and exit: the time limit was reached."""
        self.proc.kill()
        print(f'sent kill to process {self.proc.pid}, '
              'waiting for it to end')
        self.proc.wait()
        self._restore_terminal()
        seek_to_end_of_stdout()
        if self.cause is None:
            load = ', '.join(f'{x:.2f}' for x in os.getloadavg())
            elapsed = int(time.time() - self.opts.start_time)
            print(f'\nTIMEOUT after {elapsed} seconds of wall-clock time'
                  f' - load average: {load}')
        else:
            print(f'Simulation terminated due to {self.cause}.')
        sys.stdout.flush()
        sys.exit(0)

    def _filter_output(self) -> None:
        """Pass the process's output through, watching for failures."""
        assert self.proc.stdout is not None
        descriptor = self.proc.stdout.fileno()
        pending = b''
        boots = 0
        while True:
            chunk = os.read(descriptor, 4096)
            if not chunk:
                return
            sys.stdout.flush()
            sys.stdout.buffer.write(chunk)
            sys.stdout.buffer.flush()
            pending += chunk
            while b'\n' in pending:
                raw, _, pending = pending.partition(b'\n')
                if self.cause is not None:
                    continue
                line = raw.decode('utf-8', 'replace')
                found = re.search(r'(Kernel PANIC|User process ABORT)', line)
                if found:
                    self.cause = found.group(1).lower()
                elif 'Pintos booting' in line:
                    boots += 1
                    if boots > 1:
                        self.cause = 'triple fault'
                elif 'FAILED' in line:
                    self.cause = 'test failure'
                if self.cause is not None:
                    signal.alarm(FAILURE_GRACE_SECONDS)


def seek_to_end_of_stdout() -> None:
    """Move standard output to the end of the file, if it is a file."""
    sys.stdout.flush()
    try:
        os.lseek(1, 0, os.SEEK_END)
    except OSError:
        pass


def run_subprocess(opts: Options, command: Sequence[str]) -> int:
    """Run ``command`` under a ``Supervisor``; return its exit status."""
    terminal = termios.tcgetattr(0) if os.isatty(0) else None
    sys.stdout.flush()
    try:
        # A background process group gets stopped (SIGTTOU/SIGTTIN) when
        # QEMU touches the terminal, so only split off if stdin is no tty.
        proc = subprocess.Popen(
            list(command),
            stdout=subprocess.PIPE if opts.kill_on_failure else None,
            preexec_fn=None if os.isatty(0) else os.setpgrp)
    except OSError as error:
        raise pc.PintosError(f'{command[0]}: {error.strerror}') from error
    return Supervisor(opts, proc, terminal).run()


def run_command(opts: Options, command: Sequence[str]) -> None:
    """Print and run ``command``; fail unless it exited cleanly."""
    print(' '.join(command))
    status = run_subprocess(opts, command)
    if status not in (0, QEMU_CLEAN_EXIT):
        raise pc.PintosError('command failed')


# --------------------------------------------------------------------------
# Simulators.

def run_vm(opts: Options) -> None:
    """Run the selected simulator."""
    if opts.sim == 'bochs':
        run_bochs(opts)
    elif opts.sim == 'qemu':
        run_qemu(opts)
    elif opts.sim == 'player':
        run_player(opts)
    else:
        raise pc.PintosError(f"unknown simulator `{opts.sim}'")


def qemu_video_args(command_list: list) -> None:
    """
    Specifies appropriate arguments to a qemu command list based on the platform of the host machine.
    Author: Anish Gorakavi
    """
    match sys.platform:
        case "darwin":
            command_list += ["-display",  "cocoa,zoom-to-fit=on"]
        case _:
            raise pc.PintosError(
                f"Unsupported Platform running Qemu. Specifically: {sys.platform}")


def run_qemu(opts: Options) -> None:
    """Run QEMU."""
    if opts.vga == 'terminal':
        print("warning: qemu doesn't support --terminal")
    if opts.jitter is not None:
        print("warning: qemu doesn't support jitter")
    command = [os.environ.get('PINTOS_QEMU') or 'qemu-system-i386',
               '-device', 'isa-debug-exit']
    for index, disk in enumerate(opts.disks[:MAX_DISKS]):
        command += ['-drive', f'file={disk},format=raw,index={index},'
                    'media=disk']
    command += ['-m', str(opts.mem), '-net', 'none']
    qemu_video_args(command)  # Add appropriate video args per platform
    if opts.vga == 'none':
        command.append('-nographic')
    if opts.serial and opts.vga != 'none':
        command += ['-serial', 'stdio']
    if opts.debug == 'monitor':
        command.append('-S')
    if opts.debug == 'gdb':
        command += ['-gdb', f'tcp::{opts.gdb_port}', '-S']
    if opts.vga == 'none' and opts.debug == 'none':
        command += ['-monitor', 'null']
    run_command(opts, command)


def bochs_disk_line(device: str, disk: Optional[str]) -> str:
    """Return the bochsrc line for ``disk`` on ``device``, if any."""
    if disk is None:
        return ''
    geometry = disk_geometry(disk)
    return (f'{device}: type=disk, path={disk}, mode=flat, '
            f'cylinders={geometry.cylinders}, heads={geometry.heads}, '
            f'spt={geometry.sectors}, translation=none\n')


def find_in_path(program: str) -> Optional[str]:
    """Return ``program`` if it is an executable found on ``$PATH``."""
    return program if shutil.which(program) else None


def run_bochs(opts: Options) -> None:
    """Run Bochs."""
    # Select the Bochs binary based on the chosen debugger.
    binary = 'bochs-dbg' if opts.debug == 'monitor' else 'bochs'

    squish_pty = None
    if opts.serial:
        squish_pty = find_in_path('squish-pty')
        if squish_pty is None:
            print("warning: can't find squish-pty, so terminal input "
                  'will fail')

    # Write the bochsrc.txt configuration file.
    disks: List[Optional[str]] = list(opts.disks[:MAX_DISKS])
    disks += [None] * (MAX_DISKS - len(disks))
    lines = [
        'romimage: file=$BXSHARE/BIOS-bochs-latest\n',
        'vgaromimage: file=$BXSHARE/VGABIOS-lgpl-latest\n',
        'boot: disk\n',
        'cpu: ips=1000000\n',
        f'megs: {opts.mem}\n',
        'log: bochsout.txt\n',
        'panic: action=fatal\n',
        '# For older bochs:\n',
        '#user_shortcut: keys=ctrlaltdel\n',
        '# For more recent bochs:\n',
        'keyboard: user_shortcut=ctrl-alt-del\n',
    ]
    if opts.debug == 'gdb':
        lines.append(f'gdbstub: enabled=1, port={opts.gdb_port}\n')
    clock = 'realtime' if opts.realtime else 'none'
    lines.append(f'clock: sync={clock}, time0=0\n')
    if len(opts.disks) > 2:
        lines.append('ata1: enabled=1, ioaddr1=0x170, ioaddr2=0x370, '
                     'irq=15\n')
    for device, disk in zip(('ata0-master', 'ata0-slave', 'ata1-master',
                             'ata1-slave'), disks):
        lines.append(bochs_disk_line(device, disk))
    if opts.vga != 'terminal':
        if opts.serial:
            mode = 'term' if squish_pty is not None else 'file'
            lines.append(f'com1: enabled=1, mode={mode}, dev=/dev/stdout\n')
        if opts.vga == 'none':
            lines.append('display_library: nogui\n')
    else:
        lines.append('display_library: term\n')
    with open('bochsrc.txt', 'w') as bochsrc:
        bochsrc.writelines(lines)

    # Compose the Bochs command line.
    command = [binary, '-q']
    if squish_pty is not None:
        command.insert(0, squish_pty)
    if opts.jitter is not None:
        command += ['-j', str(opts.jitter)]

    # Run Bochs.  Its exit code is ignored: it normally exits with status
    # 1, which is weird.
    print(' '.join(command))
    status = run_subprocess(opts, command)
    if status < 0:
        raise pc.PintosError(f'Bochs died with signal {-status}')


def run_player(opts: Options) -> None:
    """Run VMware Player."""
    def unsupported(flag: str) -> None:
        print(f'warning: no support for {flag} with VMware Player')

    if opts.debug != 'none':
        unsupported(f'--{opts.debug}')
    if opts.vga == 'none':
        unsupported('--no-vga')
    if opts.vga == 'terminal':
        unsupported('--terminal')
    if opts.jitter is not None:
        unsupported('--jitter')
    if opts.timeout is not None:
        unsupported('--timeout')
        opts.timeout = None
    if opts.kill_on_failure:
        unsupported('--kill-on-failure')
        opts.kill_on_failure = False

    memory = pc.round_up(opts.mem, 4)    # Must be a multiple of 4 MB.

    vmx = [
        '#! /usr/bin/vmware -G\n',
        'config.version = 8\n',
        'guestOS = "linux"\n',
        f'memsize = {memory}\n',
        'floppy0.present = FALSE\n',
        'usb.present = FALSE\n',
        'sound.present = FALSE\n',
        'gui.exitAtPowerOff = TRUE\n',
        'gui.exitOnCLIHLT = TRUE\n',
        'gui.powerOnAtStartUp = TRUE\n',
    ]
    if opts.serial:
        vmx += [
            'serial0.present = TRUE\n',
            'serial0.fileType = "pipe"\n',
            'serial0.fileName = "pintos.socket"\n',
            'serial0.pipe.endPoint = "client"\n',
            'serial0.tryNoRxLoss = "TRUE"\n',
        ]

    for index, disk in enumerate(opts.disks[:MAX_DISKS]):
        device = f'ide{index // 2}:{index % 2}'
        plain = f'{device}.pln'
        vmx += [
            '\n',
            f'{device}.present = TRUE\n',
            f'{device}.deviceType = "plainDisk"\n',
            f'{device}.fileName = "{plain}"\n',
        ]
        cid = struct.unpack('=I', os.urandom(4))[0]
        geometry = disk_geometry(disk)
        with open(plain, 'w') as descriptor:
            descriptor.write(
                'version=1\n'
                f'CID={cid}\n'
                'parentCID=ffffffff\n'
                'createType="monolithicFlat"\n'
                '\n'
                f'RW {geometry.capacity} FLAT "{disk}" 0\n'
                '\n'
                '# The Disk Data Base\n'
                '#DDB\n'
                '\n'
                'ddb.adapterType = "ide"\n'
                'ddb.virtualHWVersion = "4"\n'
                'ddb.toolsVersion = "2"\n'
                f'ddb.geometry.cylinders = "{geometry.cylinders}"\n'
                f'ddb.geometry.heads = "{geometry.heads}"\n'
                f'ddb.geometry.sectors = "{geometry.sectors}"\n')
    with open('pintos.vmx', 'w') as config:
        config.writelines(vmx)
    umask = os.umask(0)
    os.umask(umask)
    os.chmod('pintos.vmx', 0o777 & ~umask)

    squish_unix = None
    if opts.serial:
        squish_unix = find_in_path('squish-unix')
        if squish_unix is None:
            print("warning: can't find squish-unix, so terminal input "
                  'and output will fail')

    command = ['vmplayer', os.path.join(os.getcwd(), 'pintos.vmx')]
    if squish_unix:
        command = [squish_unix, 'pintos.socket'] + command
    print(' '.join(command))
    run_subprocess(opts, command)


def main(argv: List[str]) -> int:
    """Run pintos; return the exit status."""
    opts = parse_command_line(argv)
    prepare_scratch_disk(opts)
    find_disks(opts)
    run_vm(opts)
    finish_scratch_disk(opts)
    return 0


if __name__ == '__main__':
    pc.run_tool(main)
