# -*- makefile -*-
#
# The ONE place Pintos tools are defined.  Edit these lines for your machine.
# Pintos needs a compiler/linker that produces 32-bit x86 ELF.

# --- macOS (Homebrew: i686-elf-gcc, i686-elf-binutils, qemu) ---
CC      = i686-elf-gcc
LD      = i686-elf-ld
OBJCOPY = i686-elf-objcopy
AR      = i686-elf-ar
RANLIB  = i686-elf-ranlib

# --- x86-64 Linux (native, no cross compiler) ---
#CC      = gcc -m32
#LD      = ld -melf_i386
#OBJCOPY = objcopy
#AR      = ar
#RANLIB  = ranlib

# --- Windows (MSYS2/Cygwin with an i686-elf toolchain): same as macOS ---

# Simulator: --qemu or --bochs
SIMULATOR = --qemu

# QEMU binary used by utils/pintos
export PINTOS_QEMU = qemu-system-i386

# --- Rust components (see rust/ and README.md) ---
# USE_RUST = 1 links the Rust static library into the kernel and builds the
# subsystems that have been ported to Rust from it.  USE_RUST = 0 builds the
# original all-C kernel.  Both must pass exactly the same tests.
# Needs the nightly toolchain pinned in rust/rust-toolchain.toml (./setup-rust.sh).
USE_RUST ?= 1
CARGO = cargo
CARGO_FLAGS = fun